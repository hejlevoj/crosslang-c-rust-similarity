# pitu — NVIDIA RTX PRO 4500 Blackwell, sm_120, 31.4 GiB.
#
# Blackwell is why this file exists. sm_120 needs a CUDA 13 build, and the
# site default (cu126) ships kernels only for sm_50 through sm_90, so jobs on
# this host died with "no kernel image is available for execution on the
# device". Only the hardware settings differ; everything else is inherited.

CLUSTER_NAME="pitu"

MODULES=(
  # TODO fill from: module avail 2>&1 | grep -i -E 'python|cuda'
)

# Shared with every other machine — the queue and the results live here.
WORKDIR="${WORKDIR:-$(dirname "$REPO_DIR")/crusts-work}"

PYTHON_BIN="${PYTHON_BIN:-python3}"

# CUDA 13 build, required for sm_120. Verified against the PyTorch index:
# cu126 carries torch 2.14 but not Blackwell kernels, and cu128 stops at torch
# 2.11 — too old for this project, which needs >=2.6 anyway but should stay on
# one version across hosts. cu130 and cu132 both carry 2.14.0; cu130 is the
# more conservative of the two.
#
# If setup.sh cannot resolve it, check the driver supports CUDA 13
# (nvidia-smi header) and try cu132.
TORCH_CUDA="${TORCH_CUDA:-cu130}"

# Batch size and epochs are deliberately NOT set here — see cluster/common.sh.
# This GPU has 31.4 GiB and could take a much larger batch, but the InfoNCE
# loss uses in-batch negatives, so raising it on one host alone would make
# these runs incomparable with the rest of the matrix.

# export CUDA_VISIBLE_DEVICES=0
