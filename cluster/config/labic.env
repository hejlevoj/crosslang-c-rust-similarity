# Labic — per-host configuration.
#
# FILL IN the values marked TODO by running the discovery commands in
# cluster/README.md on the machine. Everything here is host-specific; nothing
# below is guessed from a working Labic session.

CLUSTER_NAME="labic"

# Modules to load, in order. Run `module avail` to see what exists.
# Leave the array empty if the host has no module system.
MODULES=(
  # TODO e.g. "python/3.11" "cuda/12.1"
)

# Where the virtualenv and all large artefacts live. Point this at scratch or
# a project share, NOT at $HOME — the model caches and checkpoints are tens of
# gigabytes and home quotas are usually small.
WORKDIR="${WORKDIR:-$HOME/crusts}"   # TODO confirm the right filesystem

# Python to build the venv from, after the modules are loaded.
PYTHON_BIN="${PYTHON_BIN:-python3}"

# CUDA wheel index for torch. Check the node with nvidia-smi and read the
# "CUDA Version" in the header.
#
# torch>=2.6 is REQUIRED - transformers refuses to load unixcoder-base, which
# has no safetensors, on anything older (CVE-2025-32434). Not every index
# carries a new enough build:
#
#   cu118  up to 2.7.1   ok
#   cu121  up to 2.5.1   TOO OLD - never use this one
#   cu124  up to 2.6.0   ok, only just
#   cu126  up to 2.14.0  preferred
#   cu128  up to 2.11.0  ok
#
# CUDA 12.x drivers are minor-version compatible, so a 12.x driver generally
# runs any cu12x build - cu126 is the safe default on any CUDA 12 node.
# Set to "cpu" to force a CPU-only build.
TORCH_CUDA="${TORCH_CUDA:-cu126}"     # TODO confirm against nvidia-smi

# Batch sizes. The defaults in the code are sized for a few GB of CPU RAM;
# raise these to fill the GPU. Start here and tune with nvidia-smi.
export BATCH_SIZE="${BATCH_SIZE:-32}"
export EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-64}"
export EPOCHS="${EPOCHS:-5}"

# Pin to specific GPUs if the host is shared. Empty means "use what torch sees".
# export CUDA_VISIBLE_DEVICES=0
